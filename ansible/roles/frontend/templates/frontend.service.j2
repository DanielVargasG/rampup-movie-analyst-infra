[Unit]
Description=Movie Analyst UI (frontend)
After=network.target

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ repo_dest }}/{{ frontend_subdir }}
EnvironmentFile={{ repo_dest }}/{{ frontend_subdir }}/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target